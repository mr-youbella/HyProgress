# Copy this file to .env.local and fill in your own values.
# Required for player lookups. Never use a NEXT_PUBLIC_ prefix for these settings.
HYPIXEL_API_KEY=replace_with_your_hypixel_api_key

# Optional: PostgreSQL search analytics. Apply db/schema.sql before enabling.
# Leave blank to run without database-backed analytics.
DATABASE_URL=

# Optional: database CA certificate when required for TLS verification.
# Supports a multiline PEM or a quoted value with escaped line breaks:
# SUPABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
SUPABASE_CA_CERT=

# Optional: distributed request limiting. Configure both Upstash REST values.
# Leave both blank to run without Redis rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: HTTP Basic Authentication for /admin.
# Leave blank to keep the admin area inaccessible.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: sign the one-hour admin-preview cookie, which skips search logging.
# Use a long, random secret when enabling admin preview.
ADMIN_SESSION_SECRET=
